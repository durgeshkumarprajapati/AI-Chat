  project Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  claimA  KnowledgeClaim @relation("ClaimA", fields: [claimAId], references: [id], onDelete: Cascade)
  claimB  KnowledgeClaim @relation("ClaimB", fields: [claimBId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([claimAId])
  @@index([claimBId])
  @@index([status])
  @@map("knowledge_conflicts")
}

model KnowledgeGraphJob {
