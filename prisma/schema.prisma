model KnowledgeEntity {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  projectId       String?             @map("project_id")
  knowledgeBaseId String?             @map("knowledge_base_id")
  canonicalName   String              @map("canonical_name")
  normalizedName  String              @map("normalized_name")
  entityType      KnowledgeEntityType @default(OTHER) @map("entity_type")
  description     String?             @db.Text
  aliases         Json?               @default("[]")
  confidence      Float               @default(1.0)
  status          KnowledgeGraphStatus @default(ACTIVE)
  metadata        Json?               @default("{}")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  sourceRelationships KnowledgeRelationship[] @relation("SourceEntity")
  targetRelationships KnowledgeRelationship[] @relation("TargetEntity")
  subjectClaims       KnowledgeClaim[]        @relation("SubjectEntity")
  objectClaims        KnowledgeClaim[]        @relation("ObjectEntity")
  evidences           KnowledgeEvidence[]

  @@index([userId])
  @@index([projectId])
  @@index([knowledgeBaseId])
  @@index([normalizedName])
  @@index([entityType])
  @@index([status])
  @@map("knowledge_entities")
}

model KnowledgeRelationship {
  id               String                    @id @default(uuid())
  userId           String                    @map("user_id")
  projectId        String?                   @map("project_id")
  sourceEntityId   String                    @map("source_entity_id")
  targetEntityId   String                    @map("target_entity_id")
  relationshipType KnowledgeRelationshipType @default(RELATED_TO) @map("relationship_type")
  description      String?                   @db.Text
  confidence       Float                     @default(1.0)
  status           KnowledgeGraphStatus      @default(ACTIVE)
  fingerprint      String?                   @map("fingerprint")
  metadata         Json?                     @default("{}")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEntity KnowledgeEntity @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity KnowledgeEntity @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  evidences KnowledgeEvidence[]

  @@index([userId])
  @@index([projectId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationshipType])
  @@index([fingerprint])
  @@map("knowledge_relationships")
}

model KnowledgeEvidence {
  id             String   @id @default(uuid())
  entityId       String?  @map("entity_id")
  relationshipId String?  @map("relationship_id")
  claimId        String?  @map("claim_id")
  documentId     String   @map("document_id")
  chunkId        String   @map("chunk_id")
  pageNumber     Int?     @map("page_number")
  sourceTextHash String   @map("source_text_hash")
  snippet        String?  @db.Text
  confidence     Float    @default(1.0)
  createdAt      DateTime @default(now()) @map("created_at")

  entity       KnowledgeEntity?       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  relationship KnowledgeRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  claim        KnowledgeClaim?        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  document     Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk        DocumentChunk          @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([relationshipId])
  @@index([claimId])
  @@index([documentId])
  @@index([chunkId])
  @@index([sourceTextHash])
  @@map("knowledge_evidences")
}

model KnowledgeClaim {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  projectId       String?              @map("project_id")
  subjectEntityId String               @map("subject_entity_id")
  predicate       String
  objectEntityId  String?              @map("object_entity_id")
  value           String?              @db.Text
  normalizedClaim String               @map("normalized_claim")
  confidence      Float                @default(1.0)
  status          KnowledgeGraphStatus @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subjectEntity KnowledgeEntity @relation("SubjectEntity", fields: [subjectEntityId], references: [id], onDelete: Cascade)
  objectEntity  KnowledgeEntity? @relation("ObjectEntity", fields: [objectEntityId], references: [id], onDelete: SetNull)

  evidences KnowledgeEvidence[]
  conflictsA KnowledgeConflict[] @relation("ClaimA")
  conflictsB KnowledgeConflict[] @relation("ClaimB")

  @@index([userId])
  @@index([projectId])
  @@index([subjectEntityId])
  @@index([objectEntityId])
  @@index([normalizedClaim])
  @@map("knowledge_claims")
}

model KnowledgeConflict {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  projectId   String?        @map("project_id")
  claimAId    String         @map("claim_a_id")
  claimBId    String         @map("claim_b_id")
