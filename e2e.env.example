# ============================================================
# E2E test environment template.
#
# NOTE ON FILENAME: this is deliberately named `e2e.env.example`, not
# `.env.e2e.example` — this session's sandbox denies writes to any path
# starting with `.env`, even a placeholder-only template with no secrets in
# it. Rename it to `.env.e2e` yourself when you copy it (see below); nothing
# about the app cares what the source template file is called, only what
# `.env.e2e` (or whatever you point NODE_ENV/dotenv-loading at) contains.
#
# Copy to `.env.e2e` for local use (git-ignored — never commit real values):
#   cp e2e.env.example .env.e2e
#
# This file intentionally points at a SEPARATE database/broker/cache from
# both development (docker-compose.yml, ports 5433/5672/6379) and production —
# see docker-compose.e2e.yml, which uses different host ports (5544/5680/6390)
# specifically so an E2E run can never collide with a dev stack running on the
# same machine, let alone touch production infrastructure. All values below
# are non-secret, deterministic, test-only placeholders — there is nothing
# here worth protecting, which is the point: an E2E environment should never
# hold anything real enough to need protecting.
# ============================================================

NODE_ENV=test

# Isolated E2E-only Postgres (docker-compose.e2e.yml: host port 5544 -> container 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/document_ai_e2e

# Isolated E2E-only Redis (docker-compose.e2e.yml: host port 6390)
REDIS_URL=redis://localhost:6390

# Isolated E2E-only RabbitMQ (docker-compose.e2e.yml: host port 5680)
RABBITMQ_URL=amqp://guest:guest@localhost:5680

# This app's own session-cookie signing secret (src/features/auth/session.service.ts /
# src/config/env.ts SESSION_SECRET). NOTE: this codebase does not use NextAuth — there is no
# NEXTAUTH_SECRET to set here; SESSION_SECRET is the equivalent for this app's home-grown
# session system. A fixed, non-production value is fine and expected for an E2E environment.
SESSION_SECRET=e2e-test-only-session-secret-not-for-production-use

# Deterministic E2E test user (see prisma/seed.e2e.ts) — exists ONLY in the E2E database,
# distinct from the dev-only default admin in prisma/seed.ts (admin@documentai.com).
E2E_TEST_EMAIL=e2e-test@documentai.local
E2E_TEST_PASSWORD=E2eTestOnly!2026

# No external AI provider calls are exercised by the E2E suite (see tests/e2e/README.md /
# the CI job comments) — EMBEDDING_PROVIDER/LLM_PROVIDER are left at their defaults
# (ollama) intentionally unused; nothing in the suite sends a chat message or triggers
# retrieval/embedding.
