  createdAt      DateTime @default(now()) @map("created_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([projectId, conversationId])
  @@index([projectId])
  @@index([conversationId])
  @@map("project_conversations")
}

model CopilotSession {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  projectId      String?              @map("project_id")
  conversationId String?              @map("conversation_id")
  status         CopilotSessionStatus @default(IDLE)
  intent         CopilotIntent        @default(QUESTION)
  title          String
  resultSummary  String?              @db.Text @map("result_summary")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  actions CopilotAction[]
  events  CopilotEvent[]

  @@index([userId])
  @@index([projectId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@map("copilot_sessions")
}

model CopilotGoal {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  projectId   String?             @map("project_id")
  title       String
  description String?             @db.Text
  category    CopilotGoalCategory @default(PROJECT)
  status      CopilotGoalStatus   @default(IN_PROGRESS)
  priority    CopilotGoalPriority @default(MEDIUM)
  targetDate  DateTime?           @map("target_date")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([category])
  @@index([status])
  @@map("copilot_goals")
}

model CopilotMemory {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  projectId  String?               @map("project_id")
  category   CopilotMemoryCategory @default(PROJECT_CONTEXT)
  key        String
  value      String                @db.Text
  confidence Float                 @default(1.0)
  source     String                @default("user_explicit")
  expiresAt  DateTime?             @map("expires_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, key, projectId])
  @@index([userId])
  @@index([projectId])
  @@index([category])
  @@map("copilot_memories")
}

model CopilotAction {
  id                    String              @id @default(uuid())
  sessionId             String              @map("session_id")
  capability            CopilotCapability
  status                CopilotActionStatus @default(PROPOSED)
  input                 Json                @default("{}")
  output                Json?
  requiresConfirmation Boolean             @default(false) @map("requires_confirmation")
  confirmedAt           DateTime?           @map("confirmed_at")
  startedAt             DateTime?           @map("started_at")
  completedAt           DateTime?           @map("completed_at")
  error                 String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at")

  session CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([capability])
  @@index([status])
  @@map("copilot_actions")
}

model CopilotEvent {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  type      CopilotEventType
  data      Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at")

  session CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@map("copilot_events")
}

