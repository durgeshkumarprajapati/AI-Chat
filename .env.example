CITY_EXPLORER_MAX_CONCURRENT_GEMINI=3
CITY_EXPLORER_MAX_CONCURRENT_WEB=3
CITY_EXPLORER_GEMINI_TIMEOUT_MS=8000
CITY_EXPLORER_WEBSEARCH_TIMEOUT_MS=5000
CITY_EXPLORER_SOURCE_TIMEOUT_MS=2500
CITY_EXPLORER_REQUEST_TIMEOUT_MS=12000
CITY_EXPLORER_MAX_SOURCE_FETCHES=3
CITY_EXPLORER_STATIC_TTL_SECONDS=86400
CITY_EXPLORER_DYNAMIC_TTL_SECONDS=600
CITY_EXPLORER_REQUESTS_PER_MINUTE=60
CITY_EXPLORER_CACHE_VERSION="v4"
CITY_EXPLORER_PROMPT_VERSION="v4"
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_MS=15000
LLM_CIRCUIT_HALF_OPEN_MAX_PROBES=2

# Phase 48 — Collaboration UX: Timestamps, Mentions & Voice Messages
COLLAB_MESSAGE_TIMESTAMP_REFRESH_MS=60000
COLLAB_MENTIONS_ENABLED=true
COLLAB_MENTION_MAX_PER_MESSAGE=20

VOICE_MESSAGE_ENABLED=true
