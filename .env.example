# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_ai?schema=public"

# Message Queue
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Cache / Storage
REDIS_URL="redis://localhost:6379"

# Storage Driver ('local' or 's3')
STORAGE_PROVIDER="local"

# AWS S3 Storage (Required if STORAGE_PROVIDER="s3")
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET_NAME="document-ai-rag-bucket"

# Embedding Provider ('ollama' or 'openai')
EMBEDDING_PROVIDER="ollama"

# Ollama Local Embeddings (Used when EMBEDDING_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSIONS=768

# LLM Chat Provider ('ollama' or 'openai')
LLM_PROVIDER="ollama"
OLLAMA_CHAT_MODEL="llama3.2"

# OpenAI API (Required when EMBEDDING_PROVIDER="openai" or LLM_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL="gpt-4o-mini"

# RAG Search Configuration
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30

# Batch Processing
EMBEDDING_BATCH_SIZE=100

# Document Chunking Settings
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120

# Application Settings
APP_URL="http://localhost:3000"
NODE_ENV="development"
