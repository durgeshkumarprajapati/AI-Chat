# ============================================================
# CONFIGURATION ARCHITECTURE
# ============================================================
#
# IMPORTANT:
#
# This file is ONLY for:
# - API keys
# - API secrets
# - OAuth credentials
# - passwords
# - encryption keys
# - authentication secrets
# - infrastructure connection credentials
#
# DO NOT add non-secret runtime configuration here.
#
# Examples of configuration that belongs in PostgreSQL Config:
# - feature enable/disable flags
# - AI model names
# - timeouts
# - TTL values
# - retry limits
# - thresholds
# - cache settings
# - RAG performance settings
# - runtime limits
#
# When adding a NEW SECRET or CREDENTIAL:
# → Add it to .env.example
# → Add validation to src/config/env.ts
# → Configure it in the deployment secret manager
#
# When adding NEW NON-SECRET RUNTIME CONFIGURATION:
# → Add it to the Config Registry (src/features/config/config.registry.ts)
# → Add its default value to prisma/seed.ts
# → Run the database seed safely
# → Manage it through /admin/configuration
#
# PostgreSQL Config is the source of truth for non-secret runtime settings.
# Existing administrator-modified values must NEVER be overwritten by seed runs.
# ============================================================

# Database Connection Credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_ai?schema=public"

# Message Queue Credentials
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Cache / Storage Credentials
REDIS_URL="redis://localhost:6379"

# Storage Driver ('local' or 's3')
AWS_STORAGE_PROVIDER="local"
STORAGE_PROVIDER="local"

# AWS S3 Storage Credentials (Only required when AWS_STORAGE_PROVIDER="s3")
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# Security Secrets & Auth Keys
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-long"
NEXTAUTH_SECRET="super-secret-nextauth-key-32-chars"
ENCRYPTION_KEY="super-secret-encryption-key-32chars!"
SESSION_SECRET="rag-platform-super-secret-session-key-32chars!"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# AI Provider API Keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=""

# Third-Party Integration Credentials
CLICKUP_CLIENT_ID=""
CLICKUP_CLIENT_SECRET=""

# Application URL & Node Environment
APP_URL="http://localhost:3000"
NODE_ENV="development"
