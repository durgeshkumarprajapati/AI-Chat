generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FeedbackRating {
  POSITIVE
  NEGATIVE
}

enum FeedbackReason {
  INCORRECT_ANSWER
  NOT_RELEVANT
  MISSING_INFORMATION
  INCORRECT_CITATION
  POOR_EXPLANATION
  OTHER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  name                 String?
  role                 UserRole          @default(USER)
  authProvider         AuthProvider      @default(EMAIL) @map("auth_provider")
  status               UserStatus        @default(ACTIVE)
  emailVerified        Boolean           @default(true) @map("email_verified")
  lastLoginAt          DateTime?         @map("last_login_at")
  passwordHash         String?           @map("password_hash")
  googleId             String?           @unique @map("google_id")
  avatarUrl            String?           @map("avatar_url")
  passwordResetToken   String?           @map("password_reset_token")
  passwordResetExpires DateTime?         @map("password_reset_expires")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  documents       Document[]
  conversations   Conversation[]
  knowledgeBases  KnowledgeBase[]
  userFeedbacks   UserFeedback[]
  ragEvaluations  RagEvaluation[]
  sessions        Session[]
  chatAttachments ChatAttachment[]
  auditLogs       AuditLog[]        @relation("ActorAuditLogs")
  roadmaps               Roadmap[]
  sharedRoadmapsOwned    RoadmapShare[] @relation("RoadmapShareOwner")
  sharedRoadmapsReceived RoadmapShare[] @relation("RoadmapShareRecipient")
  studySessions          StudySession[]
  studyAnswers           StudyAnswer[]
  studyAttempts          StudyAttempt[]

  @@map("users")
}

enum SourceType {
  DOCUMENT
  WEB
}

model Document {
  id               String                  @id @default(uuid())
  userId           String                  @map("user_id")
  sourceType       SourceType              @default(DOCUMENT) @map("source_type")
  filename         String
  originalFilename String                  @map("original_filename")
  mimeType         String                  @map("mime_type")
  fileSize         Int                     @map("file_size")
  storageKey       String                  @map("storage_key")
  webUrl           String?                 @map("web_url")
  canonicalUrl     String?                 @map("canonical_url")
  contentHash      String?                 @map("content_hash")
  fetchedAt        DateTime?               @map("fetched_at")
  status           DocumentStatus          @default(UPLOADING)
  version          Int                     @default(1)
  pageCount        Int                     @default(0) @map("page_count")
  errorMessage     String?                 @map("error_message")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  visuals        DocumentVisual[]
  knowledgeBases KnowledgeBaseDocument[]
  studySessionSources StudySessionSource[]

  @@index([userId])
  @@index([status])
  @@index([sourceType])
  @@map("documents")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     KnowledgeBaseDocument[]
  conversations Conversation[]
  ragEvaluations RagEvaluation[]
  studySessions       StudySession[]
  studySessionSources StudySessionSource[]

  @@index([userId])
  @@map("knowledge_bases")
}

model KnowledgeBaseDocument {
  knowledgeBaseId String   @map("knowledge_base_id")
  documentId      String   @map("document_id")
  createdAt       DateTime @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([knowledgeBaseId, documentId])
  @@index([documentId])
  @@map("knowledge_base_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  pageNumber Int      @map("page_number")
  tokenCount Int      @map("token_count")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  embedding Unsupported("vector")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@index([embedding], map: "document_chunks_embedding_hnsw_idx")
  @@map("document_chunks")
}

model Conversation {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  knowledgeBaseId String?  @map("knowledge_base_id")
  title           String   @default("New Chat")
  summary         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  messages      Message[]
  userFeedbacks UserFeedback[]
  ragEvaluations RagEvaluation[]

  @@index([userId])
  @@index([knowledgeBaseId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  citations      Json?       @default("[]")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userFeedback UserFeedback?
  ragEvaluation RagEvaluation?

  @@index([conversationId])
  @@map("messages")
}

model UserFeedback {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  conversationId String          @map("conversation_id")
  messageId      String          @unique @map("message_id")
  rating         FeedbackRating
  reason         FeedbackReason?
  comment        String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([rating])
  @@map("user_feedbacks")
}

model RagEvaluation {
  id                       String    @id @default(uuid())
  userId                   String    @map("user_id")
  conversationId           String    @map("conversation_id")
  messageId                String    @unique @map("message_id")
  knowledgeBaseId          String?   @map("knowledge_base_id")
  question                 String    @db.Text
  retrievalQuery           String?   @db.Text @map("retrieval_query")
  answer                   String    @db.Text
  overallScore             Float?    @map("overall_score")
  groundednessScore        Float?    @map("groundedness_score")
  relevanceScore           Float?    @map("relevance_score")
  citationCoverageScore     Float?    @map("citation_coverage_score")
  retrievalConfidenceScore Float?    @map("retrieval_confidence_score")
  latencyMs                Int?      @map("latency_ms")
  responseLatencyMs        Int?      @map("response_latency_ms")
  retrievalLatencyMs       Int?      @map("retrieval_latency_ms")
  llmLatencyMs             Int?      @map("llm_latency_ms")
  llmFirstTokenMs          Int?      @map("llm_first_token_ms")
  evaluationLatencyMs      Int?      @map("evaluation_latency_ms")
  latencyTrace             Json?     @map("latency_trace")
  retrievedChunkCount      Int       @default(0) @map("retrieved_chunk_count")
  citedChunkCount          Int       @default(0) @map("cited_chunk_count")
  isFallback               Boolean   @default(false) @map("is_fallback")
  evaluatorType            String    @default("heuristic") @map("evaluator_type")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([knowledgeBaseId])
  @@index([createdAt])
  @@map("rag_evaluations")
}

model DocumentVisual {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  pageNumber   Int      @default(1) @map("page_number")
  type         String   @default("IMAGE")
  storageKey   String?  @map("storage_key")
  contentHash  String?  @map("content_hash")
  caption      String?
  ocrText      String?  @map("ocr_text")
  metadata     Json?    @default("{}")
  width        Int?
  height       Int?
  confidence   Float?   @default(1.0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([pageNumber])
  @@index([type])
  @@map("document_visuals")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  sessionToken String   @unique @map("session_token")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceInfo   String?  @map("device_info")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ChatAttachment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  filename       String
  mimeType       String   @map("mime_type")
  fileSize       Int      @map("file_size")
  storageKey     String   @map("storage_key")
  isTemporary    Boolean  @default(true) @map("is_temporary")
  documentId     String?  @map("document_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@map("chat_attachments")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

enum RoadmapStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SharePermission {
  VIEW
  EDIT
}

model Roadmap {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  title                 String
  description           String
  goal                  String
  targetSkill           String        @map("target_skill")
  experienceLevel       String        @map("experience_level")
  dailyTimeCommitment   String        @map("daily_time_commitment")
  targetDurationWeeks   Int           @map("target_duration_weeks")
  learningStyle         String        @map("learning_style")
  status                RoadmapStatus @default(ACTIVE)
  currentProgress       Float         @default(0) @map("current_progress")
  questionnaireSnapshot Json          @map("questionnaire_snapshot")
  generationVersion     Int           @default(1) @map("generation_version")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases RoadmapPhase[]
  shares RoadmapShare[]
  studySessions       StudySession[]
  studySessionSources StudySessionSource[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("roadmaps")
}

model RoadmapPhase {
  id            String   @id @default(uuid())
  roadmapId     String   @map("roadmap_id")
  title         String
  description   String
  order         Int
  durationWeeks Int      @default(1) @map("duration_weeks")
  status        String   @default("NOT_STARTED")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks   RoadmapTask[]

  @@index([roadmapId])
  @@index([roadmapId, order])
  @@map("roadmap_phases")
}

model RoadmapTask {
  id             String    @id @default(uuid())
  phaseId        String    @map("phase_id")
  title          String
  description    String
  order          Int
  estimatedHours Float     @default(1) @map("estimated_hours")
  status         String    @default("PENDING")
  completedAt    DateTime? @map("completed_at")
  notes          String?
  resources      Json?     @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  phase RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@index([phaseId, order])
  @@index([status])
  @@map("roadmap_tasks")
}

model RoadmapShare {
  id               String          @id @default(uuid())
  roadmapId        String          @map("roadmap_id")
  ownerId          String          @map("owner_id")
  sharedWithUserId String          @map("shared_with_user_id")
  permission       SharePermission @default(VIEW)
  revokedAt        DateTime?       @map("revoked_at")
  expiresAt        DateTime?       @map("expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  roadmap        Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  owner          User    @relation("RoadmapShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithUser User    @relation("RoadmapShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([sharedWithUserId])
  @@index([ownerId])
  @@index([revokedAt])
  @@map("roadmap_shares")
}

// ====================================================
// PHASE 33 — AI STUDY / TUTOR MODE ENUMS & MODELS
// ====================================================

enum StudyGoal {
  DEEP_UNDERSTANDING
  EXAM_PREPARATION
  INTERVIEW_PREP
  QUICK_REVISION
  CERTIFICATION_PREP
}

enum StudyDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum StudyLearningStyle {
  EXPLANATION
  SOCRATIC
  QUIZ_FIRST
  MIXED
}

enum StudyMode {
  TEACH
  SOCRATIC
  QUIZ
  FLASHCARDS
  PRACTICE
  REVIEW
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum StudyQuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  SCENARIO
  PRACTICE_CODE
}

model StudySession {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  knowledgeBaseId    String?            @map("knowledge_base_id")
  roadmapId          String?            @map("roadmap_id")
  title              String
  goal               StudyGoal          @default(DEEP_UNDERSTANDING)
  difficulty         StudyDifficulty    @default(BEGINNER)
  learningStyle      StudyLearningStyle @default(MIXED)
  currentMode        StudyMode          @default(TEACH) @map("current_mode")
  durationMinutes    Int                @default(30) @map("duration_minutes")
  status             StudySessionStatus @default(ACTIVE)
  currentTopicId     String?            @map("current_topic_id")
  progressPercent    Float              @default(0) @map("progress_percent")
  externalWebEnabled Boolean            @default(false) @map("external_web_enabled")
  startedAt          DateTime           @default(now()) @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase?       @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  roadmap       Roadmap?             @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  sources       StudySessionSource[]
  topics        StudyTopic[]
  answers       StudyAnswer[]
  progresses    StudyProgress[]
  attempts      StudyAttempt[]

  @@index([userId])
  @@index([userId, status])
  @@index([knowledgeBaseId])
  @@index([roadmapId])
  @@map("study_sessions")
}

model StudySessionSource {
  id              String   @id @default(uuid())
  sessionId       String   @map("session_id")
  documentId      String?  @map("document_id")
  knowledgeBaseId String?  @map("knowledge_base_id")
  roadmapId       String?  @map("roadmap_id")
  sourceType      String   @default("DOCUMENT") @map("source_type")
  createdAt       DateTime @default(now()) @map("created_at")

  session       StudySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  roadmap       Roadmap?       @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([documentId])
  @@index([knowledgeBaseId])
  @@index([roadmapId])
  @@map("study_session_sources")
}

model StudyTopic {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  title        String
  description  String   @db.Text
  order        Int
  status       String   @default("PENDING")
  masteryScore Float    @default(0) @map("mastery_score")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session    StudySession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questions  StudyQuestion[]
  progresses StudyProgress[]

  @@index([sessionId])
  @@index([sessionId, order])
  @@map("study_topics")
}

model StudyQuestion {
  id                String            @id @default(uuid())
  topicId           String            @map("topic_id")
  questionType      StudyQuestionType @default(MCQ) @map("question_type")
  question          String            @db.Text
  options           Json?             @default("[]")
  expectedAnswer    String            @db.Text @map("expected_answer")
  explanation       String            @db.Text
  difficulty        StudyDifficulty   @default(BEGINNER)
  sourceFingerprint String?           @map("source_fingerprint")
  createdAt         DateTime          @default(now()) @map("created_at")

  topic    StudyTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers  StudyAnswer[]
  attempts StudyAttempt[]

  @@index([topicId])
  @@index([questionType])
  @@map("study_questions")
}

model StudyAnswer {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  sessionId  String   @map("session_id")
  userId     String   @map("user_id")
  answer     String   @db.Text
  isCorrect  Boolean  @map("is_correct")
  score      Float    @default(0)
  feedback   String   @db.Text
  hintsUsed  Int      @default(0) @map("hints_used")
  createdAt  DateTime @default(now()) @map("created_at")

  question StudyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  session  StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([sessionId])
  @@index([userId])
  @@map("study_answers")
}

model StudyProgress {
  id                 String    @id @default(uuid())
  sessionId          String    @map("session_id")
  topicId            String    @map("topic_id")
  attemptedQuestions Int       @default(0) @map("attempted_questions")
  correctAnswers     Int       @default(0) @map("correct_answers")
  masteryScore       Float     @default(0) @map("mastery_score")
  lastReviewedAt     DateTime? @map("last_reviewed_at")
  nextReviewAt       DateTime? @map("next_review_at")

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic   StudyTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([sessionId, topicId])
  @@index([sessionId])
  @@index([topicId])
  @@index([nextReviewAt])
  @@map("study_progresses")
}

model StudyAttempt {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  answer     String   @db.Text
  score      Float    @default(0)
  feedback   String   @db.Text
  latencyMs  Int?     @map("latency_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  session  StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question StudyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@index([userId])
  @@map("study_attempts")
}

