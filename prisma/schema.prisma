  googleCalendarEventId  String?             @map("google_calendar_event_id")
  googleCalendarEventUrl String?             @db.Text @map("google_calendar_event_url")
  googleMeetUrl          String?             @db.Text @map("google_meet_url")
  googleMeetConferenceId String?             @map("google_meet_conference_id")
  calendarSyncStatus     CalendarSyncStatus  @default(PENDING) @map("calendar_sync_status")
  calendarSyncError      String?             @db.Text @map("calendar_sync_error")
  calendarSyncErrorCode  String?             @map("calendar_sync_error_code")
  calendarSyncAttempts   Int                 @default(0) @map("calendar_sync_attempts")
  lastCalendarSyncAt     DateTime?           @map("last_calendar_sync_at")
  nextRetryAt            DateTime?           @map("next_retry_at")
  cancelledAt            DateTime?           @map("cancelled_at")
  cancelledById          String?             @map("cancelled_by_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  channel      CollabChannel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("ScheduledCallOrganizer", fields: [createdById], references: [id], onDelete: Cascade)
  cancelledBy  User?                      @relation("ScheduledCallCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  participants ScheduledCallParticipant[]
  collabMessages CollabMessage[]          @relation("ScheduledCallMessages")

  @@index([channelId, scheduledStartAt])
  @@index([createdById, scheduledStartAt])
  @@index([status, scheduledStartAt])
  @@index([calendarSyncStatus, scheduledStartAt])
  @@index([googleCalendarEventId])
  @@index([nextRetryAt])
  @@map("scheduled_calls")
}

model ScheduledCallParticipant {
  id              String                         @id @default(uuid())
  scheduledCallId String                         @map("scheduled_call_id")
  userId          String                         @map("user_id")
  email           String?
  role            String                         @default("ATTENDEE")
  responseStatus  ScheduledCallParticipantStatus @default(INVITED) @map("response_status")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  scheduledCall ScheduledCall @relation(fields: [scheduledCallId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduledCallId, userId])
  @@index([scheduledCallId])
  @@index([userId, scheduledCallId])
  @@map("scheduled_call_participants")
}

enum VoiceTutorSessionMode {
  FREE_TUTOR
  QUIZ_TUTOR
  INTERVIEW_TUTOR
  DOCUMENT_TUTOR
  KNOWLEDGE_GRAPH_TUTOR
}

enum VoiceTutorSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum VoiceTutorRole {
  USER
  ASSISTANT
  SYSTEM
}

model VoiceTutorSession {
  id              String                 @id @default(uuid())
  userId          String                 @map("user_id")
  title           String                 @default("AI Voice Tutoring Session")
  mode            VoiceTutorSessionMode   @default(FREE_TUTOR)
  status          VoiceTutorSessionStatus @default(ACTIVE)
  knowledgeBaseId String?                @map("knowledge_base_id")
  documentId      String?                @map("document_id")
  startedAt       DateTime               @default(now()) @map("started_at")
  endedAt         DateTime?              @map("ended_at")
  durationSeconds Int                    @default(0) @map("duration_seconds")
  totalMessages   Int                    @default(0) @map("total_messages")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase?      @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  document      Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  messages      VoiceTutorMessage[]
  feedback      VoiceTutorFeedback?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([knowledgeBaseId])
  @@index([documentId])
  @@map("voice_tutor_sessions")
}

model VoiceTutorMessage {
  id           String         @id @default(uuid())
  sessionId    String         @map("session_id")
  role         VoiceTutorRole
  text         String         @db.Text
  audioUrl     String?        @db.Text @map("audio_url")
  durationMs   Int?           @map("duration_ms")
  ragContext   Json?          @map("rag_context")
  graphContext Json?          @map("graph_context")
  metadata     Json?          @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at")

  session VoiceTutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("voice_tutor_messages")
}

model VoiceTutorFeedback {
  id                       String   @id @default(uuid())
  sessionId                String   @unique @map("session_id")
  userId                   String   @map("user_id")
  topic                    String   @default("General Voice Tutoring")
  durationMinutes          Int      @default(0) @map("duration_minutes")
  conceptsDiscussed        Json     @default("[]") @map("concepts_discussed")
  strengths                Json     @default("[]")
  weaknesses               Json     @default("[]")
  recommendedTopics        Json     @default("[]") @map("recommended_topics")
  understandingScore       Int      @default(80) @map("understanding_score")
  communicationScore       Int      @default(80) @map("communication_score")
  recommendedMockTestTopic String?  @map("recommended_mock_test_topic")
  createdAt                DateTime @default(now()) @map("created_at")

  session VoiceTutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("voice_tutor_feedbacks")
}

enum ChillFocusMode {
  CHILL
  FOCUS
}

enum ChillFocusStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  EXPIRED
}

model ChillFocusSession {
  id                    String           @id @default(uuid())
  userId                String           @map("user_id")
  mode                  ChillFocusMode   @default(CHILL)
  status                ChillFocusStatus @default(ACTIVE)
  startedAt             DateTime         @default(now()) @map("started_at")
  pausedAt              DateTime?        @map("paused_at")
  resumedAt             DateTime?        @map("resumed_at")
  completedAt           DateTime?        @map("completed_at")
  plannedDurationSeconds Int              @default(300) @map("planned_duration_seconds")
  activeDurationSeconds  Int              @default(0) @map("active_duration_seconds")
  soundscape            String           @default("night_sky")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("chill_focus_sessions")
}

model ChillFocusPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  preferredMode       String   @default("CHILL") @map("preferred_mode")
  preferredSoundscape String   @default("night_sky") @map("preferred_soundscape")
  preferredVolume     Float    @default(0.7) @map("preferred_volume")
  breathingEnabled    Boolean  @default(true) @map("breathing_enabled")
  interventionEnabled Boolean  @default(true) @map("intervention_enabled")
  reducedMotion       Boolean  @default(false) @map("reduced_motion")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chill_focus_preferences")
}

model ChillFocusStreak {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  currentStreakDays      Int       @default(0) @map("current_streak_days")
  longestStreakDays      Int       @default(0) @map("longest_streak_days")
  lastActiveDate         DateTime? @map("last_active_date")
  totalSessionsCompleted Int       @default(0) @map("total_sessions_completed")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chill_focus_streaks")
}

// ==========================================
// PHASE 74 — AI MEETING INTELLIGENCE + CLICKUP INTEGRATION
// ==========================================

enum MeetingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MeetingSourceProvider {
  GOOGLE_MEET
  MANUAL_PASTE
  UPLOAD_FILE
  CONNECTED_SOURCE
}

enum TaskSuggestionStatus {
  PENDING
  APPROVED
  CREATING
  CREATED
  FAILED
}

enum ClickUpIntegrationStatus {
  ACTIVE
  DISCONNECTED
}

model Meeting {
  id             String                @id @default(uuid())
  userId         String                @map("user_id")
  projectId      String?               @map("project_id")
  title          String
  description    String?               @db.Text
  meetingDate    DateTime              @default(now()) @map("meeting_date")
  sourceProvider MeetingSourceProvider @default(MANUAL_PASTE) @map("source_provider")
  status         MeetingStatus         @default(PENDING)
  errorMessage   String?               @map("error_message") @db.Text
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  participants    MeetingParticipant[]
  transcript      MeetingTranscript?
  analysis        MeetingAnalysis?
  taskSuggestions MeetingTaskSuggestion[]

  @@index([userId, status])
  @@index([projectId])
  @@map("meetings")
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String   @map("meeting_id")
  name      String
  email     String?
  role      String?  @default("ATTENDEE")
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_participants")
}

model MeetingTranscript {
  id                String   @id @default(uuid())
  meetingId         String   @unique @map("meeting_id")
  rawContent        String   @db.Text @map("raw_content")
  normalizedContent String   @db.Text @map("normalized_content")
  language          String   @default("en")
  wordCount         Int      @default(0) @map("word_count")
  createdAt         DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_transcripts")
}

model MeetingAnalysis {
  id            String   @id @default(uuid())
  meetingId     String   @unique @map("meeting_id")
  summary       String   @db.Text
  discussion    Json?    @default("[]")
  decisions     Json     @default("[]")
  actionItems   Json     @default("[]")
  risks         Json     @default("[]")
  blockers      Json     @default("[]")
  openQuestions Json     @default("[]")
  confidence    Float    @default(0.9)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_analyses")
}

model MeetingTaskSuggestion {
  id                String               @id @default(uuid())
  meetingId         String               @map("meeting_id")
  userId            String               @map("user_id")
  title             String
  description       String?              @db.Text
  suggestedAssignee String?              @map("suggested_assignee")
  suggestedDueDate  DateTime?            @map("suggested_due_date")
  confidence        Float                @default(0.9)
  status            TaskSuggestionStatus @default(PENDING)
  clickUpTaskId     String?              @map("clickup_task_id")
  clickUpUrl        String?              @map("clickup_url")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  link    ClickUpTaskLink?

  @@index([meetingId, status])
  @@index([userId])
  @@map("meeting_task_suggestions")
}

model ClickUpTaskLink {
  id                 String   @id @default(uuid())
  suggestionId       String   @unique @map("suggestion_id")
  clickUpTaskId      String   @map("clickup_task_id")
  clickUpUrl         String?  @map("clickup_url")
  clickUpWorkspaceId String?  @map("clickup_workspace_id")
  clickUpListId      String?  @map("clickup_list_id")
  status             String   @default("CREATED")
  lastError          String?  @map("last_error") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  suggestion MeetingTaskSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@map("clickup_task_links")
}

model ClickUpIntegration {
  id            String                   @id @default(uuid())
  userId        String                   @map("user_id")
  accessToken   String                   @map("access_token")
  tokenType     String                   @default("Bearer") @map("token_type")
  workspaceId   String?                  @map("workspace_id")
  workspaceName String?                  @map("workspace_name")
  status        ClickUpIntegrationStatus @default(ACTIVE)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("clickup_integrations")
}









