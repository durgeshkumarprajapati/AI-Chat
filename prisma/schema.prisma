generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum DocumentStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  COMPLETED
  ACTIVE
  SUPERSEDED
  REINDEXING
  ARCHIVED
  FAILED
  DELETING
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FeedbackRating {
  POSITIVE
  NEGATIVE
}

enum FeedbackReason {
  INCORRECT_ANSWER
  NOT_RELEVANT
  MISSING_INFORMATION
  INCORRECT_CITATION
  POOR_EXPLANATION
  OTHER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  name                 String?
  role                 UserRole          @default(USER)
  authProvider         AuthProvider      @default(EMAIL) @map("auth_provider")
  status               UserStatus        @default(ACTIVE)
  emailVerified        Boolean           @default(true) @map("email_verified")
  lastLoginAt          DateTime?         @map("last_login_at")
  passwordHash         String?           @map("password_hash")
  googleId             String?           @unique @map("google_id")
  avatarUrl            String?           @map("avatar_url")
  passwordResetToken   String?           @map("password_reset_token")
  passwordResetExpires DateTime?         @map("password_reset_expires")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  documents       Document[]
  conversations   Conversation[]
  knowledgeBases  KnowledgeBase[]
  userFeedbacks   UserFeedback[]
  ragEvaluations  RagEvaluation[]
  sessions        Session[]
  chatAttachments ChatAttachment[]
  auditLogs       AuditLog[]        @relation("ActorAuditLogs")
  roadmaps               Roadmap[]
  sharedRoadmapsOwned    RoadmapShare[] @relation("RoadmapShareOwner")
  sharedRoadmapsReceived RoadmapShare[] @relation("RoadmapShareRecipient")
  studySessions          StudySession[]
  studyAnswers           StudyAnswer[]
  studyAttempts          StudyAttempt[]
  researchSessions       ResearchSession[]
  workflows              Workflow[]
  workflowRuns           WorkflowRun[]
  sharedWorkflowsOwned   WorkflowShare[] @relation("WorkflowShareOwner")
  sharedWorkflowsReceived WorkflowShare[] @relation("WorkflowShareRecipient")
  projectsOwned          Project[]        @relation("ProjectOwner")
  projectMemberships     ProjectMember[]
  copilotSessions        CopilotSession[]
  copilotGoals           CopilotGoal[]
  copilotMemories        CopilotMemory[]
  knowledgeEntities      KnowledgeEntity[]
  knowledgeRelationships KnowledgeRelationship[]
  knowledgeClaims        KnowledgeClaim[]
  knowledgeConflicts     KnowledgeConflict[]
  knowledgeGraphJobs     KnowledgeGraphJob[]
  knowledgeGraphVersions KnowledgeGraphVersion[]
  tourProgress           UserTourProgress[]
  createdCollabChannels  CollabChannel[]        @relation("CreatedCollabChannels")
  collabMemberships      CollabChannelMember[]
  collabMessagesSent     CollabMessage[]
  collabReceipts         CollabMessageReceipt[]
  collabMentions         CollabMessageMention[] @relation("UserCollabMentions")
  createdMockTests       ScheduledMockTest[]    @relation("CreatedMockTests")
  mockTestParticipants   MockTestParticipant[]
  calendarSyncs          MockTestCalendarSync[]
  collabCallsHosted      CollabCall[]           @relation("HostedCollabCalls")
  collabCallParticipations CollabCallParticipant[]
  googleIntegration      GoogleIntegration?
  notifications          Notification[]         @relation("UserNotifications")
  triggeredNotifications Notification[]         @relation("TriggeredNotifications")
  createdScheduledCalls    ScheduledCall[]        @relation("ScheduledCallOrganizer")
  cancelledScheduledCalls  ScheduledCall[]        @relation("ScheduledCallCanceller")
  scheduledCallParticipations ScheduledCallParticipant[]
  notificationPreference NotificationPreference?
  voiceTutorSessions     VoiceTutorSession[]
  voiceTutorFeedbacks    VoiceTutorFeedback[]
  chillFocusSessions     ChillFocusSession[]
  chillFocusPreference   ChillFocusPreference?
  chillFocusStreak       ChillFocusStreak?
  documentIntelligenceRuns DocumentIntelligence[]
  documentMultimodalRuns DocumentMultimodalRun[]
  documentVersionsUploaded DocumentVersion[]
  documentDuplicateFingerprints DocumentDuplicateFingerprint[]
  ragConversationsCreated RagConversation[] @relation("RagConversationCreator")
  ragConversationMemberships RagConversationMember[]
  ragMessages RagMessage[]
  ragConversationDocumentSourcesAdded RagConversationDocumentSource[] @relation("RagConversationDocumentSourceAddedBy")
  ragConversationKbSourcesAdded RagConversationKnowledgeBaseSource[] @relation("RagConversationKbSourceAddedBy")
  documentFamilies              DocumentFamily[]
  documentLifecycleEvents       DocumentLifecycleEvent[]
  documentRetentionJobs         DocumentRetentionJob[]
  meetings                      Meeting[]
  clickUpIntegrations           ClickUpIntegration[]

  @@map("users")
}

enum SourceType {
  DOCUMENT
  WEB
}

model Document {
  id                  String                  @id @default(uuid())
  userId              String                  @map("user_id")
  familyId            String?                 @map("family_id")
  sourceType          SourceType              @default(DOCUMENT) @map("source_type")
  filename            String
  originalFilename    String                  @map("original_filename")
  mimeType            String                  @map("mime_type")
  fileSize            Int                     @map("file_size")
  storageKey          String                  @map("storage_key")
  webUrl              String?                 @map("web_url")
  canonicalUrl        String?                 @map("canonical_url")
  contentHash         String?                 @map("content_hash")
  fetchedAt           DateTime?               @map("fetched_at")
  status              DocumentStatus          @default(UPLOADING)
  version             Int                     @default(1)
  activeVersionNumber Int                     @default(1) @map("active_version_number")
  pageCount           Int                     @default(0) @map("page_count")
  isArchived          Boolean                 @default(false) @map("is_archived")
  archivedAt          DateTime?               @map("archived_at")
  isDeleted           Boolean                 @default(false) @map("is_deleted")
  deletedAt           DateTime?               @map("deleted_at")
  errorMessage        String?                 @map("error_message")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  user                   User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  family                 DocumentFamily?                 @relation(fields: [familyId], references: [id], onDelete: SetNull)
  chunks                 DocumentChunk[]
  visuals                DocumentVisual[]
  knowledgeBases         KnowledgeBaseDocument[]
  studySessionSources    StudySessionSource[]
  researchSources        ResearchSource[]
  researchEvidences      ResearchEvidence[]
  projects               ProjectDocument[]
  knowledgeEvidences     KnowledgeEvidence[]
  knowledgeGraphJobs     KnowledgeGraphJob[]
  voiceTutorSessions     VoiceTutorSession[]
  intelligence           DocumentIntelligence?
  multimodalRun          DocumentMultimodalRun?
  extractedTables        ExtractedTable[]
  images                 DocumentImage[]
  charts                 DocumentChart[]
  versions               DocumentVersion[]
  duplicateFingerprint   DocumentDuplicateFingerprint?
  ragConversationSources RagConversationDocumentSource[]
  lineageSourceRelations DocumentLineage[]                @relation("LineageSource")
  lineageTargetRelations DocumentLineage[]                @relation("LineageTarget")
  lifecycleEvents        DocumentLifecycleEvent[]
  retentionJobs          DocumentRetentionJob[]

  @@index([userId])
  @@index([status])
  @@index([sourceType])
  @@index([userId, isDeleted, isArchived, status])
  @@index([familyId])
  @@index([isDeleted, deletedAt])
  @@map("documents")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     KnowledgeBaseDocument[]
  conversations Conversation[]
  ragEvaluations RagEvaluation[]
  studySessions       StudySession[]
  studySessionSources StudySessionSource[]
  researchSessions    ResearchSession[]
  projects            ProjectKnowledgeBase[]
  knowledgeEntities   KnowledgeEntity[]
  knowledgeGraphJobs  KnowledgeGraphJob[]
  voiceTutorSessions  VoiceTutorSession[]
  ragConversationSources RagConversationKnowledgeBaseSource[]

  @@index([userId])
  @@map("knowledge_bases")
}

model KnowledgeBaseDocument {
  knowledgeBaseId String   @map("knowledge_base_id")
  documentId      String   @map("document_id")
  createdAt       DateTime @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([knowledgeBaseId, documentId])
  @@index([documentId])
  @@map("knowledge_base_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  pageNumber Int      @map("page_number")
  tokenCount Int      @map("token_count")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  embedding Unsupported("vector")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeEvidences KnowledgeEvidence[]
  extractedTables    ExtractedTable[]
  documentImages     DocumentImage[]
  documentCharts     DocumentChart[]

  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@index([embedding], map: "document_chunks_embedding_hnsw_idx")
  @@map("document_chunks")
}

model Conversation {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  knowledgeBaseId String?  @map("knowledge_base_id")
  title           String   @default("New Chat")
  summary         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  messages      Message[]
  userFeedbacks UserFeedback[]
  ragEvaluations RagEvaluation[]
  projects      ProjectConversation[]
  copilotSessions CopilotSession[]

  @@index([userId])
  @@index([knowledgeBaseId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  citations      Json?       @default("[]")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userFeedback UserFeedback?
  ragEvaluation RagEvaluation?

  @@index([conversationId])
  @@map("messages")
}

model UserFeedback {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  conversationId String          @map("conversation_id")
  messageId      String          @unique @map("message_id")
  rating         FeedbackRating
  reason         FeedbackReason?
  comment        String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([rating])
  @@map("user_feedbacks")
}

model RagEvaluation {
  id                       String    @id @default(uuid())
  userId                   String    @map("user_id")
  conversationId           String    @map("conversation_id")
  messageId                String    @unique @map("message_id")
  knowledgeBaseId          String?   @map("knowledge_base_id")
  question                 String    @db.Text
  retrievalQuery           String?   @db.Text @map("retrieval_query")
  answer                   String    @db.Text
  overallScore             Float?    @map("overall_score")
  groundednessScore        Float?    @map("groundedness_score")
  relevanceScore           Float?    @map("relevance_score")
  citationCoverageScore     Float?    @map("citation_coverage_score")
  retrievalConfidenceScore Float?    @map("retrieval_confidence_score")
  latencyMs                Int?      @map("latency_ms")
  responseLatencyMs        Int?      @map("response_latency_ms")
  retrievalLatencyMs       Int?      @map("retrieval_latency_ms")
  llmLatencyMs             Int?      @map("llm_latency_ms")
  llmFirstTokenMs          Int?      @map("llm_first_token_ms")
  evaluationLatencyMs      Int?      @map("evaluation_latency_ms")
  latencyTrace             Json?     @map("latency_trace")
  retrievedChunkCount      Int       @default(0) @map("retrieved_chunk_count")
  citedChunkCount          Int       @default(0) @map("cited_chunk_count")
  isFallback               Boolean   @default(false) @map("is_fallback")
  evaluatorType            String    @default("heuristic") @map("evaluator_type")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([knowledgeBaseId])
  @@index([createdAt])
  @@map("rag_evaluations")
}

model DocumentVisual {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  pageNumber   Int      @default(1) @map("page_number")
  type         String   @default("IMAGE")
  storageKey   String?  @map("storage_key")
  contentHash  String?  @map("content_hash")
  caption      String?
  ocrText      String?  @map("ocr_text")
  metadata     Json?    @default("{}")
  width        Int?
  height       Int?
  confidence   Float?   @default(1.0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([pageNumber])
  @@index([type])
  @@map("document_visuals")
}

// PHASE 69 — DOCUMENT INTELLIGENCE PIPELINE (69A: layout-aware/semantic chunking, metadata extraction, classification)

enum DocumentIntelligenceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum DocumentIntelligenceStage {
  LAYOUT_ANALYSIS
  SEMANTIC_CHUNKING
  METADATA_EXTRACTION
  CLASSIFICATION
  DONE
}

enum DocumentType {
  CONTRACT
  INVOICE
  REPORT
  ACADEMIC_PAPER
  RESUME
  EMAIL
  MANUAL
  PRESENTATION
  SPREADSHEET_EXPORT
  LEGAL_FILING
  OTHER
}

model DocumentIntelligence {
  id                        String                     @id @default(uuid())
  documentId                String                     @unique @map("document_id")
  userId                    String                     @map("user_id")
  status                    DocumentIntelligenceStatus @default(PENDING)
  stage                     DocumentIntelligenceStage?
  legacyFallbackUsed        Boolean                    @default(false) @map("legacy_fallback_used")
  layoutAnalysisEnabled     Boolean                    @default(false) @map("layout_analysis_enabled")
  semanticChunkingEnabled   Boolean                    @default(false) @map("semantic_chunking_enabled")
  metadataExtractionEnabled Boolean                    @default(false) @map("metadata_extraction_enabled")
  classificationEnabled     Boolean                    @default(false) @map("classification_enabled")
  documentType              DocumentType?              @map("document_type")
  classificationConfidence  Float?                     @map("classification_confidence")
  extractedMetadata         Json?                      @default("{}") @map("extracted_metadata")
  chunkingStrategy          String?                    @map("chunking_strategy")
  attempts                  Int                        @default(0)
  startedAt                 DateTime?                  @map("started_at")
  completedAt               DateTime?                  @map("completed_at")
  errorCode                 String?                    @map("error_code")
  errorMessage              String?                    @db.Text @map("error_message")
  metadata                  Json?                      @default("{}")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@map("document_intelligence")
}

// PHASE 69C — ADVANCED MULTIMODAL DOCUMENT INTELLIGENCE (OCR / table / image / chart)

enum DocumentMultimodalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum DocumentMultimodalStage {
  OCR
  TABLE_EXTRACTION
  IMAGE_ANALYSIS
  CHART_EXTRACTION
  DONE
}

model DocumentMultimodalRun {
  id                     String                    @id @default(uuid())
  documentId             String                    @unique @map("document_id")
  userId                 String                    @map("user_id")
  status                 DocumentMultimodalStatus  @default(PENDING)
  stage                  DocumentMultimodalStage?
  ocrEnabled             Boolean                   @default(false) @map("ocr_enabled")
  tableExtractionEnabled Boolean                   @default(false) @map("table_extraction_enabled")
  imageAnalysisEnabled   Boolean                   @default(false) @map("image_analysis_enabled")
  chartExtractionEnabled Boolean                   @default(false) @map("chart_extraction_enabled")
  tablesExtracted        Int                       @default(0) @map("tables_extracted")
  imagesFound            Int                       @default(0) @map("images_found")
  imagesAnalyzed         Int                       @default(0) @map("images_analyzed")
  chartsExtracted        Int                       @default(0) @map("charts_extracted")
  attempts               Int                       @default(0)
  startedAt              DateTime?                 @map("started_at")
  completedAt            DateTime?                 @map("completed_at")
  errorCode              String?                   @map("error_code")
  errorMessage           String?                   @db.Text @map("error_message")
  metadata               Json?                     @default("{}")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("document_multimodal_runs")
}

model ExtractedTable {
  id                     String   @id @default(uuid())
  documentId             String   @map("document_id")
  pageNumber             Int      @map("page_number")
  tableIndex             Int      @map("table_index")
  title                  String?
  headers                Json
  rows                   Json
  markdownRepresentation String   @db.Text @map("markdown_representation")
  extractionConfidence   Float    @default(1.0) @map("extraction_confidence")
  extractionProvider     String   @default("mock") @map("extraction_provider")
  chunkId                String?  @map("chunk_id")
  createdAt              DateTime @default(now()) @map("created_at")

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([documentId, pageNumber])
  @@index([chunkId])
  @@map("extracted_tables")
}

model DocumentImage {
  id                String   @id @default(uuid())
  documentId        String   @map("document_id")
  pageNumber        Int      @map("page_number")
  imageIndex        Int      @map("image_index")
  storageKey        String?  @map("storage_key")
  mimeType          String?  @map("mime_type")
  ocrText           String?  @db.Text @map("ocr_text")
  ocrProvider       String?  @map("ocr_provider")
  visionDescription String?  @db.Text @map("vision_description")
  visionEntities    Json?    @default("[]") @map("vision_entities")
  visionProvider    String?  @map("vision_provider")
  visionConfidence  Float?   @map("vision_confidence")
  chunkId           String?  @map("chunk_id")
  createdAt         DateTime @default(now()) @map("created_at")

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([documentId, pageNumber])
  @@index([chunkId])
  @@map("document_images")
}

model DocumentChart {
  id                  String   @id @default(uuid())
  documentId          String   @map("document_id")
  pageNumber          Int      @map("page_number")
  chartIndex          Int      @map("chart_index")
  storageKey          String?  @map("storage_key")
  chartType           String?  @map("chart_type")
  description         String?  @db.Text
  extractedDataPoints Json?    @default("[]") @map("extracted_data_points")
  confidence          Float?
  provider            String?
  chunkId             String?  @map("chunk_id")
  createdAt           DateTime @default(now()) @map("created_at")

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([documentId, pageNumber])
  @@index([chunkId])
  @@map("document_charts")
}

// PHASE 69D — ENTERPRISE DOCUMENT MANAGEMENT (versioning, duplicate detection, re-indexing)

model DocumentVersion {
  id               String         @id @default(uuid())
  documentId       String         @map("document_id")
  versionNumber    Int            @map("version_number")
  storageKey       String         @map("storage_key")
  contentHash      String         @map("content_hash")
  fileSize         Int            @map("file_size")
  pageCount        Int            @default(0) @map("page_count")
  uploadedByUserId String         @map("uploaded_by_user_id")
  status           DocumentStatus @default(UPLOADING)
  isActive         Boolean        @default(false) @map("is_active")
  errorMessage     String?        @map("error_message")
  createdAt        DateTime       @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([documentId, isActive])
  @@map("document_versions")
}

model DocumentDuplicateFingerprint {
  id                        String   @id @default(uuid())
  userId                    String   @map("user_id")
  documentId                String   @unique @map("document_id")
  contentHash               String   @map("content_hash")
  normalizedTextFingerprint String?  @map("normalized_text_fingerprint")
  createdAt                 DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, contentHash])
  @@index([userId, normalizedTextFingerprint])
  @@map("document_duplicate_fingerprints")
}

enum LineageType {
  ORIGINAL
  NEW_VERSION
  DERIVED_FROM
  MERGED_FROM
  SPLIT_FROM
  IMPORTED_FROM
}

enum LifecycleEventType {
  DOCUMENT_UPLOADED
  DOCUMENT_DUPLICATE_DETECTED
  DOCUMENT_VERSION_CREATED
  DOCUMENT_VERSION_ACTIVATED
  DOCUMENT_VERSION_SUPERSEDED
  DOCUMENT_COMPARED
  DOCUMENT_REINDEX_STARTED
  DOCUMENT_REINDEX_COMPLETED
  DOCUMENT_REINDEX_FAILED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
  DOCUMENT_SOFT_DELETED
  DOCUMENT_PERMANENTLY_DELETED
  DOCUMENT_LINEAGE_CREATED
}

model DocumentFamily {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String
  activeDocumentId String?  @map("active_document_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([userId])
  @@map("document_families")
}

model DocumentLineage {
  id               String      @id @default(uuid())
  sourceDocumentId String      @map("source_document_id")
  targetDocumentId String      @map("target_document_id")
  relationshipType LineageType @default(NEW_VERSION) @map("relationship_type")
  metadata         Json?       @default("{}")
  createdAt        DateTime    @default(now()) @map("created_at")

  sourceDocument Document @relation("LineageSource", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument Document @relation("LineageTarget", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId])
  @@index([targetDocumentId])
  @@map("document_lineages")
}

model DocumentLifecycleEvent {
  id            String             @id @default(uuid())
  documentId    String             @map("document_id")
  userId        String             @map("user_id")
  eventType     LifecycleEventType @map("event_type")
  previousState String?            @map("previous_state")
  newState      String?            @map("new_state")
  metadata      Json?              @default("{}")
  createdAt     DateTime           @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId, eventType])
