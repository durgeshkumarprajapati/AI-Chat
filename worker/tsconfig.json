{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "../",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "../",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../src/lib/storage.ts",
    "../src/lib/s3.ts",
    "../src/lib/rabbitmq.ts",
    "../src/config/env.ts",
    "../src/errors/**/*",
    "../src/features/llm/**/*",
    "../src/features/rag/multimodal/**/*",
    "../src/features/document-intelligence/**/*",
    "../src/features/multimodal-document-intelligence/**/*",
    "../src/features/document-management/**/*",
    "../src/features/config/**/*",
    "../src/features/billing/**/*",
    "../src/features/audit/**/*",
    "../src/features/project-intelligence/**/*",
    "../src/features/meeting-intelligence/**/*",
    "../src/features/projects/project.service.ts",
    "../src/features/projects/project-authorization.service.ts",
    "../src/features/calendar/**/*",
    "../src/features/integrations/**/*"
  ]
}
