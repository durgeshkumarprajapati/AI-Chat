generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FeedbackRating {
  POSITIVE
  NEGATIVE
}

enum FeedbackReason {
  INCORRECT_ANSWER
  NOT_RELEVANT
  MISSING_INFORMATION
  INCORRECT_CITATION
  POOR_EXPLANATION
  OTHER
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  documents      Document[]
  conversations  Conversation[]
  knowledgeBases KnowledgeBase[]
  userFeedbacks  UserFeedback[]
  ragEvaluations RagEvaluation[]

  @@map("users")
}

model Document {
  id               String                  @id @default(uuid())
  userId           String                  @map("user_id")
  filename         String
  originalFilename String                  @map("original_filename")
  mimeType         String                  @map("mime_type")
  fileSize         Int                     @map("file_size")
  storageKey       String                  @map("storage_key")
  status           DocumentStatus          @default(UPLOADING)
  version          Int                     @default(1)
  pageCount        Int                     @default(0) @map("page_count")
  errorMessage     String?                 @map("error_message")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  knowledgeBases KnowledgeBaseDocument[]

  @@index([userId])
  @@index([status])
  @@map("documents")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     KnowledgeBaseDocument[]
  conversations Conversation[]
  ragEvaluations RagEvaluation[]

  @@index([userId])
  @@map("knowledge_bases")
}

model KnowledgeBaseDocument {
  knowledgeBaseId String   @map("knowledge_base_id")
  documentId      String   @map("document_id")
  createdAt       DateTime @default(now()) @map("created_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([knowledgeBaseId, documentId])
  @@index([documentId])
  @@map("knowledge_base_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  pageNumber Int      @map("page_number")
  tokenCount Int      @map("token_count")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  embedding Unsupported("vector")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@index([embedding], map: "document_chunks_embedding_hnsw_idx")
  @@map("document_chunks")
}

model Conversation {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  knowledgeBaseId String?  @map("knowledge_base_id")
  title           String   @default("New Chat")
  summary         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  messages      Message[]
  userFeedbacks UserFeedback[]
  ragEvaluations RagEvaluation[]

  @@index([userId])
  @@index([knowledgeBaseId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  citations      Json?       @default("[]")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userFeedback UserFeedback?
  ragEvaluation RagEvaluation?

  @@index([conversationId])
  @@map("messages")
}

model UserFeedback {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  conversationId String          @map("conversation_id")
  messageId      String          @unique @map("message_id")
  rating         FeedbackRating
  reason         FeedbackReason?
  comment        String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([rating])
  @@map("user_feedbacks")
}

model RagEvaluation {
  id                       String    @id @default(uuid())
  userId                   String    @map("user_id")
  conversationId           String    @map("conversation_id")
  messageId                String    @unique @map("message_id")
  knowledgeBaseId          String?   @map("knowledge_base_id")
  question                 String    @db.Text
  retrievalQuery           String?   @db.Text @map("retrieval_query")
  answer                   String    @db.Text
  overallScore             Float?    @map("overall_score")
  groundednessScore        Float?    @map("groundedness_score")
  relevanceScore           Float?    @map("relevance_score")
  citationCoverageScore     Float?    @map("citation_coverage_score")
  retrievalConfidenceScore Float?    @map("retrieval_confidence_score")
  latencyMs                Int?      @map("latency_ms")
  retrievalLatencyMs       Int?      @map("retrieval_latency_ms")
  llmLatencyMs             Int?      @map("llm_latency_ms")
  retrievedChunkCount      Int       @default(0) @map("retrieved_chunk_count")
  citedChunkCount          Int       @default(0) @map("cited_chunk_count")
  isFallback               Boolean   @default(false) @map("is_fallback")
  evaluatorType            String    @default("heuristic") @map("evaluator_type")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([knowledgeBaseId])
  @@index([createdAt])
  @@map("rag_evaluations")
}