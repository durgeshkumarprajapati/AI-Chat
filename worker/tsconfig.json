{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "../",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "../",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../src/lib/storage.ts",
    "../src/lib/s3.ts",
    "../src/lib/rabbitmq.ts",
    "../src/config/env.ts",
    "../src/errors/**/*",
    "../src/features/rag/**/*",
    "../src/features/ai-agent/**/*",
    "../src/features/notifications/**/*"
  ]
}
