# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_ai?schema=public"

# Message Queue
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Cache / Storage
REDIS_URL="redis://localhost:6379"

# Storage Driver ('local' or 's3')
AWS_STORAGE_PROVIDER="local"
STORAGE_PROVIDER="local"

# AWS S3 Storage Configuration (Only required when AWS_STORAGE_PROVIDER="s3")
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# Embedding Provider ('ollama' or 'openai')
EMBEDDING_PROVIDER="ollama"

# Ollama Local Embeddings (Used when EMBEDDING_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSIONS=768

# LLM Chat Provider ('ollama' or 'openai')
LLM_PROVIDER="ollama"
OLLAMA_CHAT_MODEL="llama3.2"
RAG_LLM_MAX_OUTPUT_TOKENS=512
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_CONTEXT_CHUNKS=5
RAG_LLM_PROMPT_MAX_TOKENS=3000

# OpenAI API (Required when EMBEDDING_PROVIDER="openai" or LLM_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL="gpt-4o-mini"

# RAG Search & Hybrid Retrieval Configuration
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30
RAG_VECTOR_CANDIDATE_K=20
RAG_KEYWORD_CANDIDATE_K=20
RAG_VECTOR_WEIGHT=0.70
RAG_KEYWORD_WEIGHT=0.30
RAG_RERANK_ENABLED=true

# Worker Lifecycle & Recovery
DOCUMENT_PROCESSING_TIMEOUT_MINUTES=15

# Batch Processing
EMBEDDING_BATCH_SIZE=100

# Document Chunking Settings
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120

# Application Settings
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Phase 41 — AI Knowledge Graph
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_MAX_ENTITIES_PER_CHUNK=50
KNOWLEDGE_GRAPH_MAX_RELATIONSHIPS_PER_CHUNK=100
KNOWLEDGE_GRAPH_MAX_CLAIMS_PER_CHUNK=50
KNOWLEDGE_GRAPH_MAX_EXPANSION_DEPTH=3
# Phase 42 — Production Gemini Integration
GEMINI_ENABLED=true
GEMINI_API_KEY=""
GEMINI_FAST_MODEL="gemini-2.5-flash"
GEMINI_REASONING_MODEL="gemini-2.5-pro"
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_LEVEL="low"
GEMINI_MAX_RETRIES=2
GEMINI_RATE_LIMIT_PER_MINUTE=120

# Multi-LLM Provider Architecture — DeepSeek (Secondary Fallback)
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_DEFAULT_MODEL="deepseek-chat"
DEEPSEEK_REASONING_MODEL="deepseek-reasoner"
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

# Multi-LLM Provider Architecture — Groq (Tertiary Fallback)
GROQ_ENABLED=true
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"
GROQ_REASONING_MODEL="deepseek-r1-distill-llama-70b"
GROQ_TIMEOUT_MS=60000
GROQ_MAX_OUTPUT_TOKENS=4096

# Phase 61 — Hybrid Graph RAG & Intelligent Retrieval
RAG_HYBRID_ENABLED=true
RAG_QUERY_REWRITE_ENABLED=true
RAG_MULTI_QUERY_ENABLED=true
RAG_GRAPH_WEIGHT=0.15
RAG_MAX_RETRIEVAL_QUERIES=4
RAG_MAX_CONTEXT_TOKENS=12000
RAG_CONTEXT_NEIGHBOR_LIMIT=1
RAG_CONTEXT_EXPANSION_ENABLED=true
RAG_GROUNDING_ENABLED=true
RAG_MIN_CONFIDENCE=0.60
RAG_LEGACY_FALLBACK_ENABLED=true
RAG_INITIAL_CANDIDATES=20
RAG_FINAL_CONTEXT_RESULTS=5

# Phase 62 — Production Web Intelligence & Tavily Search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER="tavily"
WEB_SEARCH_PROVIDER_ORDER="tavily"
TAVILY_API_KEY=""
TAVILY_BASE_URL="https://api.tavily.com"
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=10000
WEB_CRAWLER_ENABLED=true
WEB_CRAWLER_MAX_PAGES=5
WEB_CRAWLER_TIMEOUT_MS=15000
WEB_RAG_CACHE_TTL_SECONDS=3600

# Phase 43 — Ultra-Low-Latency City Explorer V2 & Hotfix
CITY_EXPLORER_V2_ENABLED=true
CITY_EXPLORER_PRIMARY_PROVIDER="gemini"
CITY_EXPLORER_FALLBACK_PROVIDER="web_search"
CITY_EXPLORER_ALLOW_OLLAMA_FALLBACK=false
CITY_EXPLORER_MAX_CONCURRENCY=3
CITY_EXPLORER_MAX_CONCURRENT_GEMINI=3
CITY_EXPLORER_MAX_CONCURRENT_WEB=3
CITY_EXPLORER_GEMINI_TIMEOUT_MS=8000
CITY_EXPLORER_WEBSEARCH_TIMEOUT_MS=5000
CITY_EXPLORER_SOURCE_TIMEOUT_MS=2500
CITY_EXPLORER_REQUEST_TIMEOUT_MS=12000
CITY_EXPLORER_MAX_SOURCE_FETCHES=3
CITY_EXPLORER_STATIC_TTL_SECONDS=86400
CITY_EXPLORER_DYNAMIC_TTL_SECONDS=600
CITY_EXPLORER_REQUESTS_PER_MINUTE=60
CITY_EXPLORER_CACHE_VERSION="v4"
CITY_EXPLORER_PROMPT_VERSION="v4"
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_OPEN_MS=15000
LLM_CIRCUIT_HALF_OPEN_MAX_PROBES=2

# Phase 48 — Collaboration UX: Timestamps, Mentions & Voice Messages
COLLAB_MESSAGE_TIMESTAMP_REFRESH_MS=60000
COLLAB_MENTIONS_ENABLED=true
COLLAB_MENTION_MAX_PER_MESSAGE=20

VOICE_MESSAGE_ENABLED=true
VOICE_MESSAGE_MAX_DURATION_SECONDS=120
VOICE_MESSAGE_MAX_BYTES=10485760
VOICE_MESSAGE_ALLOWED_MIME_TYPES=audio/webm,audio/ogg,audio/mp4
VOICE_MESSAGE_STORAGE_BUCKET=
VOICE_MESSAGE_STORAGE_PREFIX=collaboration/voice/
COLLAB_VOICE_RATE_LIMIT_PER_MINUTE=10

# =====================================================
# GOOGLE AUTHENTICATION / CONTINUE WITH GOOGLE
# =====================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_AUTH_SCOPES="openid email profile"

# =====================================================
# GOOGLE CALENDAR
# =====================================================
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
GOOGLE_CALENDAR_SCOPE="https://www.googleapis.com/auth/calendar.events"

WEBRTC_STUN_SERVERS="stun:stun.l.google.com:19302"
WEBRTC_TURN_SERVERS=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""

# Knowledge Graph Pipeline Configuration
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_EXTRACTION_ENABLED=true
KNOWLEDGE_GRAPH_MAX_ENTITIES_PER_CHUNK=20
KNOWLEDGE_GRAPH_MAX_RELATIONSHIPS_PER_CHUNK=30
KNOWLEDGE_GRAPH_MAX_TRAVERSAL_DEPTH=2
KNOWLEDGE_GRAPH_MAX_NODES=200
KNOWLEDGE_GRAPH_MIN_CONFIDENCE=0.70
KNOWLEDGE_GRAPH_BATCH_SIZE=5
KNOWLEDGE_GRAPH_EXTRACTION_TIMEOUT_MS=60000

# PHASE 69 — DOCUMENT INTELLIGENCE

DOCUMENT_INTELLIGENCE_ENABLED=false
DOCUMENT_LAYOUT_ANALYSIS_ENABLED=false
DOCUMENT_SEMANTIC_CHUNKING_ENABLED=false
DOCUMENT_METADATA_EXTRACTION_ENABLED=false
DOCUMENT_CLASSIFICATION_ENABLED=false

DOCUMENT_INTELLIGENCE_LEGACY_FALLBACK_ENABLED=true

DOCUMENT_INTELLIGENCE_TIMEOUT_MS=120000
DOCUMENT_MAX_PROCESSING_RETRIES=3

SEMANTIC_CHUNK_MAX_TOKENS=1000
SEMANTIC_CHUNK_OVERLAP_TOKENS=150

# Phase 51 — AI MCQ Generation, RAG Grounding & Mock Tests
MOCK_TEST_DEFAULT_QUESTION_COUNT=10
MOCK_TEST_MAX_QUESTION_COUNT=50
MOCK_TEST_MAX_GENERATION_ATTEMPTS=3
MOCK_TEST_QUESTION_SIMILARITY_THRESHOLD=0.85

# Phase 58 — Production AI Voice Tutor
VOICE_TUTOR_ENABLED=true
VOICE_TUTOR_STT_PROVIDER="mock"
VOICE_TUTOR_TTS_PROVIDER="mock"
VOICE_TUTOR_MAX_AUDIO_BYTES=10485760
VOICE_TUTOR_MAX_AUDIO_DURATION_SECONDS=120
VOICE_TUTOR_MAX_CONTEXT_MESSAGES=10
VOICE_TUTOR_MAX_CONTEXT_TOKENS=2000
VOICE_TUTOR_SESSION_TIMEOUT_MINUTES=30
VOICE_TUTOR_REQUESTS_PER_MINUTE=20

# Phase 59 — AI Chill & Focus Mode
CHILL_FOCUS_ENABLED=true
CHILL_FOCUS_AUDIO_BASE_URL="/audio/soundscapes/"
CHILL_FOCUS_STREAK_MINUTES=5
CHILL_FOCUS_SUGGESTION_AFTER_MINUTES=50
CHILL_FOCUS_MAX_SESSION_MINUTES=120
CHILL_FOCUS_DEFAULT_MODE="CHILL"
CHILL_FOCUS_AI_INTERVENTION_ENABLED=true

# PHASE 69B — INTELLIGENCE-AWARE ADAPTIVE RETRIEVAL
RAG_INTELLIGENCE_RETRIEVAL_ENABLED=false
RAG_QUERY_INTELLIGENCE_ENABLED=false
RAG_QUERY_ROUTING_ENABLED=false
RAG_METADATA_RETRIEVAL_ENABLED=false
RAG_SECTION_AWARE_RETRIEVAL_ENABLED=false
RAG_ADAPTIVE_STRATEGY_ENABLED=false
RAG_DYNAMIC_TOP_K_ENABLED=false
RAG_ADVANCED_RERANKING_ENABLED=false

RAG_QUERY_INTELLIGENCE_TIMEOUT_MS=3000

RAG_MIN_CANDIDATE_K=10
RAG_MAX_CANDIDATE_K=40

RAG_MIN_FINAL_K=5
RAG_MAX_FINAL_K=15

RAG_RERANK_SEMANTIC_WEIGHT=0.35
RAG_RERANK_KEYWORD_WEIGHT=0.20
RAG_RERANK_GRAPH_WEIGHT=0.15
RAG_RERANK_METADATA_WEIGHT=0.10
RAG_RERANK_SECTION_WEIGHT=0.10
RAG_RERANK_DOCUMENT_TYPE_WEIGHT=0.05
RAG_RERANK_FRESHNESS_WEIGHT=0.03
RAG_RERANK_MULTIMODAL_WEIGHT=0.02

# PHASE 69C — ADVANCED MULTIMODAL DOCUMENT INTELLIGENCE
DOCUMENT_MULTIMODAL_ENABLED=false
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_PROVIDER="mock"
DOCUMENT_TABLE_EXTRACTION_ENABLED=false
DOCUMENT_TABLE_PROVIDER="mock"
DOCUMENT_IMAGE_ANALYSIS_ENABLED=false
DOCUMENT_VISION_PROVIDER="mock"
DOCUMENT_CHART_EXTRACTION_ENABLED=false
DOCUMENT_MULTIMODAL_TIMEOUT_MS=60000
DOCUMENT_MAX_IMAGES_PER_DOCUMENT=50
DOCUMENT_MAX_TABLES_PER_DOCUMENT=100
DOCUMENT_MULTIMODAL_MAX_RETRIES=3

# OPTIONAL PROVIDERS
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_VISION_ENABLED=false
GOOGLE_DOCUMENT_AI_ENABLED=false
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""
GOOGLE_DOCUMENT_AI_LOCATION=""

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_TEXTRACT_ENABLED=false

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=""
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false

TESSERACT_ENABLED=false
TESSERACT_LANGUAGE="eng"

# PHASE 69D — ENTERPRISE DOCUMENT MANAGEMENT
DOCUMENT_DUPLICATE_DETECTION_ENABLED=false
DOCUMENT_SEMANTIC_DUPLICATE_DETECTION_ENABLED=false
DOCUMENT_VERSIONING_ENABLED=false
DOCUMENT_LINEAGE_ENABLED=false
DOCUMENT_VERSION_COMPARISON_ENABLED=false
