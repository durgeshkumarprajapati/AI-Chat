  domain          String?
  sourceType      String   @default("WEB") @map("source_type")
  documentId      String?  @map("document_id")
  authorityScore  Float    @default(0.5) @map("authority_score")
  relevanceScore  Float    @default(0.5) @map("relevance_score")
  freshnessScore  Float    @default(0.5) @map("freshness_score")
  qualityScore    Float    @default(0.5) @map("quality_score")
  contentHash     String?  @map("content_hash")
  retrievedAt     DateTime @default(now()) @map("retrieved_at")
  createdAt       DateTime @default(now()) @map("created_at")

  session   ResearchSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document  Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  evidences ResearchEvidence[]

  @@index([sessionId])
  @@index([documentId])
  @@index([sourceType])
  @@map("research_sources")
}

model ResearchEvidence {
  id           String             @id @default(uuid())
  taskId       String?            @map("task_id")
  sessionId    String             @map("session_id")
  sourceId     String             @map("source_id")
  documentId   String?            @map("document_id")
  chunkId      String?            @map("chunk_id")
  visualId     String?            @map("visual_id")
  contentHash  String             @map("content_hash")
  evidenceText String             @db.Text @map("evidence_text")
  claimText    String?            @db.Text @map("claim_text")
  pageNumber   Int?               @map("page_number")
  confidence   ResearchConfidence @default(MEDIUM)
  createdAt    DateTime           @default(now()) @map("created_at")

  session  ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task     ResearchTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  source   ResearchSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([taskId])
  @@index([sourceId])
  @@index([contentHash])
  @@map("research_evidences")
}

model ResearchClaim {
  id              String             @id @default(uuid())
  sessionId       String             @map("session_id")
  claimText       String             @db.Text @map("claim_text")
  normalizedClaim String             @db.Text @map("normalized_claim")
  confidence      ResearchConfidence @default(MEDIUM)
  status          String             @default("VERIFIED")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  session ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("research_claims")
}

model ResearchConflict {
  id                String                 @id @default(uuid())
  sessionId         String                 @map("session_id")
  claimAId          String                 @map("claim_a_id")
  claimBId          String                 @map("claim_b_id")
